    <!-- About -->
    <string name="about_title">About</string>
    <string name="about_crypto_title">Contact encryption</string>
    <string name="about_crypto">Contacts are only sent when you select them; the Mac stores them AES-GCM encrypted with a key kept on that Mac (never in the Keychain, not synced to iCloud). Plaintext lives only in memory.</string>
    <string name="about_unlock_title">Remote unlock security</string>
    <string name="about_unlock">Unlock runs over BLE only — no cloud, no network. The phone proves identity with a fingerprint-gated Android Keystore ECDSA P-256 key signing a one-time 32-byte random challenge (SHA-256); the Mac verifies the signature against the paired public key, then authorizes the unlock through macOS PAM. The Mac password is never stored, transmitted, or typed.</string>
    <string name="about_device_title">Device info (Beta only)</string>
    <string name="about_device_android">Android device: %1$s · Android %2$s (API %3$d)</string>
    <string name="about_device_mac">Mac: %1$s · %2$s</string>
    <string name="about_desc">MacSync mirrors your phone to the Mac over BLE: notifications, calls, hotspot, app icons and media controls — no cloud, no Wi-Fi.</string>
